<view class="content"><view class="bg-gradient"></view><view class="nav-fixed" style="{{(scrollTop>0?'background:#FFF;':'')}}"><view style="{{('height:'+statusBarHeight+'px')}}"></view><view class="flexJusp nav-bar" style="{{('height:'+navigationBarHeight+'px;line-height:'+navigationBarHeight+'px')}}"><view data-event-opts="{{[['tap',[['tuichu',['$event']]]]]}}" class="nav-back" bindtap="__e"><image style="width:20rpx;height:34rpx;" src="/static/images/mv_tuichu.png"></image></view><view>专线入驻</view><view style="width:100rpx;"></view></view></view><view style="{{('height:'+(statusBarHeight+navigationBarHeight)+'px')}}"></view><view class="page-body"><block wx:if="{{$root.g0}}"><view class="empty-box"><view class="empty-tip">暂未添加发货地信息</view><button data-event-opts="{{[['tap',[['goAdd',['$event']]]]]}}" class="add-btn" bindtap="__e">添加</button></view></block><block wx:else><block wx:if="{{!loading}}"><view><block wx:for="{{shippingList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="ship-card"><view class="ship-title">{{item.address_text}}</view><block wx:if="{{item.shipping_logistics_park}}"><view class="ship-sub">{{item.shipping_logistics_park}}</view></block><view class="ship-sub">{{"落货地 "+(item.arrival_count||0)+" 个"}}</view><view class="ship-actions"><button class="action-btn edit" hover-class="action-btn-hover" data-event-opts="{{[['tap',[['onEdit',[index]]]]]}}" bindtap="__e">修改</button><button class="action-btn del" hover-class="action-btn-hover" data-event-opts="{{[['tap',[['onDelete',[index]]]]]}}" bindtap="__e">删除</button></view></view></block><button data-event-opts="{{[['tap',[['goAdd',['$event']]]]]}}" class="continue-btn" bindtap="__e">继续添加</button></view></block></block></view><view style="height:60rpx;"></view></view>