	color: #FFFFFF;
	line-height: 52rpx;
	text-align: center;
}
.buttonx{
	width: 138rpx;
	height: 52rpx;
	background: #FFFFFF;
	border-radius: 26rpx;
	border: 1rpx solid #CCCCCC;
	font-size: 26rpx;
	color: #666666;
	line-height: 52rpx;
	text-align: center;
