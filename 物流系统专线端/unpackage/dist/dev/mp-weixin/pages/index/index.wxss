
.banners {
	width: 710rpx;
	height: 250rpx;
	margin:0 20rpx 20rpx;
	border-radius: 20rpx;
}
.xian {
	margin:4rpx auto 0;
	width: 28rpx;
	height: 6rpx;
	background: linear-gradient( 180deg, #4897FF 0%, #4878FF 100%);
	border-radius: 4rpx;
}
.buttons {
	width: 138rpx;
	height: 52rpx;
