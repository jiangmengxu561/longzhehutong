<view class="content"><view style="width:750rpx;height:272rpx;background:linear-gradient( 180deg, #D8EEFC 0%, #F7F8FA 100%);"></view><view style="margin-top:-272rpx;"></view><view style="{{'width:750rpx;z-index:9;position:fixed;top:0;left:0;color:#000;'+(scrollTop>0?'background:#FFF;height:'+(statusBarHeight+navigationBarHeight)+'px':'')}}"><view style="{{('height:'+statusBarHeight+'px')}}"></view><view class="flexJusp" style="{{'font-weight:bold;font-size:36rpx;align-items:center;'+('height:'+navigationBarHeight+'px;line-height:'+navigationBarHeight+'px')}}"><view style="width:100rpx;"></view><view>专线接单</view><view style="width:100rpx;"></view></view></view><view style="{{('height:'+(statusBarHeight+navigationBarHeight+28)+'px')}}"></view><swiper class="banners" circular="{{true}}" autoplay="{{true}}" interval="{{3000}}" duration="{{1000}}"><block wx:for="{{banner}}" wx:for-item="item" wx:for-index="index" wx:key="index"><swiper-item><image style="width:100%;height:100%;border-radius:20rpx;" src="{{imgUrl+item}}" mode="aspectFill"></image></swiper-item></block></swiper><block wx:if="{{$root.g0==0}}"><view style="margin:100rpx 0 0;text-align:center;">暂无数据</view></block><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view style="background:#FFFFFF;border-radius:24rpx;padding:24rpx;margin:20rpx;"><view style="color:#666666;">{{"订单编号："+item.orderid}}</view><view data-event-opts="{{[['tap',[['details',['$0'],[[['list','',index]]]]]]]}}" class="flex" style="align-items:center;margin:20rpx 0;font-size:30rpx;font-weight:bold;" bindtap="__e"><view>{{item.origincity}}</view><image style="width:32rpx;height:32rpx;margin:0 20rpx;" src="/static/images/icon_36j.png"></image><view>{{item.province}}</view></view><view class="flexJusp" style="margin-top:20rpx;align-items:center;"><view style="font-weight:800;font-size:30rpx;color:#EC0000;">{{"￥"+(item.logistics_driver_cost||'未定义价格')}}</view><view data-event-opts="{{[['tap',[['qiangdan',['$0'],[[['list','',index]]]]]]]}}" class="buttons" bindtap="__e">抢单</view></view></view></block></view>