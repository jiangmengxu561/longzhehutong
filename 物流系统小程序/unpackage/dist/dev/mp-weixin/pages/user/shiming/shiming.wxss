.shiming {
  padding: 0 0 200rpx;
  color: #000;
}
.shiming .status-bar {
  margin: 28rpx 36rpx 0;
  display: flex;
  align-items: center;
}
.shiming .status-tag {
  padding: 6rpx 20rpx;
  background: rgba(72, 120, 255, 0.12);
  color: #4878FF;
  font-size: 24rpx;
  border-radius: 8rpx;
  font-weight: bold;
}
.shiming .status-time {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #999999;
}
.shiming .tip {
  margin: 24rpx 36rpx 0;
  font-size: 24rpx;
  color: #999999;
  line-height: 36rpx;
}
.shiming .formBox {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 24rpx;
}
.shiming .form-item {
  line-height: 114rpx;
  border-bottom: 2rpx solid #F0F0F0;
  align-items: center;
}
.shiming .label {
  width: 180rpx;
  font-size: 30rpx;
  color: #333333;
  flex-shrink: 0;
}
.shiming .value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
  word-break: break-all;
}
.shiming .star {
  color: #CF2D22;
  margin-right: 4rpx;
}
.shiming .agreement-box {
  margin: 32rpx 36rpx 0;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
}
.shiming .agreement-box image {
  margin-right: 12rpx;
  flex-shrink: 0;
}
.shiming .buttons {
  position: fixed;
  left: 30rpx;
  bottom: 88rpx;
  width: 690rpx;
  height: 88rpx;
  background: linear-gradient(180deg, #4897FF 0%, #4878FF 100%);
  border-radius: 50rpx;
  font-weight: bold;
  font-size: 30rpx;
  color: #FFFFFF;
  line-height: 88rpx;
  text-align: center;
}
