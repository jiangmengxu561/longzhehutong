<view class="shiming"><view style="width:750rpx;height:272rpx;background:linear-gradient( 180deg, #D8EEFC 0%, #F7F8FA 100%);"></view><view style="margin-top:-272rpx;"></view><view style="{{'width:750rpx;z-index:9;position:fixed;top:0;left:0;color:#000;'+(scrollTop>0?'background:#FFF;height:'+(statusBarHeight+navigationBarHeight)+'px':'')}}"><view style="{{('height:'+statusBarHeight+'px')}}"></view><view class="flexJusp" style="{{'font-weight:bold;font-size:36rpx;align-items:center;'+('height:'+navigationBarHeight+'px;line-height:'+navigationBarHeight+'px')}}"><view data-event-opts="{{[['tap',[['tuichu',['$event']]]]]}}" style="width:100rpx;text-align:center;" bindtap="__e"><image style="width:20rpx;height:34rpx;" src="/static/images/mv_tuichu.png"></image></view><view>实名认证</view><view style="width:100rpx;"></view></view></view><view style="{{('height:'+(statusBarHeight+navigationBarHeight)+'px')}}"></view><block wx:if="{{isAuth}}"><block><view class="status-bar"><view class="status-tag">已认证</view><block wx:if="{{authTime}}"><view class="status-time">{{"认证时间："+authTime}}</view></block></view><view class="formBox"><view class="flexJusp form-item"><view class="label">姓名</view><view class="value">{{name}}</view></view><view class="flexJusp form-item"><view class="label">电话</view><view class="value">{{phone_no}}</view></view><view class="flexJusp form-item"><view class="label">身份证号</view><view class="value">{{id_no}}</view></view><view class="flexJusp form-item"><view class="label">银行卡号</view><view class="value">{{card_no}}</view></view><view class="flexJusp form-item" style="border-bottom:none;"><view class="label">银行名</view><view class="value">{{bank_name||'—'}}</view></view></view></block></block><block wx:else><block wx:if="{{loaded}}"><block><view class="tip">请填写本人真实信息，用于银行卡四要素核验</view><view class="formBox"><view class="flexJusp form-item"><view class="label"><text class="star">*</text>姓名</view><input style="flex:1;text-align:right;font-size:28rpx;" placeholder="请输入真实姓名" data-event-opts="{{[['input',[['__set_model',['','name','$event',[]]]]]]}}" value="{{name}}" bindinput="__e"/></view><view class="flexJusp form-item"><view class="label"><text class="star">*</text>电话</view><input style="flex:1;text-align:right;font-size:28rpx;" maxlength="11" type="number" placeholder="请输入银行预留手机号" data-event-opts="{{[['input',[['__set_model',['','phone_no','$event',[]]]]]]}}" value="{{phone_no}}" bindinput="__e"/></view><view class="flexJusp form-item"><view class="label"><text class="star">*</text>身份证号</view><input style="flex:1;text-align:right;font-size:28rpx;" maxlength="18" placeholder="请输入身份证号" data-event-opts="{{[['input',[['__set_model',['','id_no','$event',[]]]]]]}}" value="{{id_no}}" bindinput="__e"/></view><view class="flexJusp form-item"><view class="label"><text class="star">*</text>银行卡号</view><input style="flex:1;text-align:right;font-size:28rpx;" maxlength="30" type="number" placeholder="请输入银行卡号" data-event-opts="{{[['input',[['__set_model',['','card_no','$event',[]]]]]]}}" value="{{card_no}}" bindinput="__e"/></view><view class="flexJusp form-item" style="border-bottom:none;"><view class="label"><text class="star">*</text>银行名</view><input style="flex:1;text-align:right;font-size:28rpx;" placeholder="请输入开户银行名称" data-event-opts="{{[['input',[['__set_model',['','bank_name','$event',[]]]]]]}}" value="{{bank_name}}" bindinput="__e"/></view></view><view class="flex agreement-box"><block wx:if="{{check}}"><image style="width:28rpx;height:28rpx;" src="/static/images/icon_1xuan1.png" data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" bindtap="__e"></image></block><block wx:else><image style="width:28rpx;height:28rpx;" src="/static/images/icon_1xuan.png" data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" bindtap="__e"></image></block><view><text data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" bindtap="__e">已阅读并同意</text><text data-event-opts="{{[['tap',[['agreement',['$event']]]]]}}" style="color:#4878FF;" bindtap="__e">《实名认证服务协议》</text></view></view><view data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" class="buttons" style="{{(submitting?'opacity:0.6;':'')}}" bindtap="__e">提交认证</view></block></block></block></view>