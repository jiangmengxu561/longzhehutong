<view class="subordinate"><view style="width:750rpx;height:272rpx;background:linear-gradient( 180deg, #D8EEFC 0%, #F7F8FA 100%);"></view><view style="margin-top:-272rpx;"></view><view style="{{'width:750rpx;z-index:9;position:fixed;top:0;left:0;color:#000;'+(scrollTop>0?'background:#FFF;height:'+(statusBarHeight+navigationBarHeight)+'px':'')}}"><view style="{{('height:'+statusBarHeight+'px')}}"></view><view class="flexJusp" style="{{'font-weight:bold;font-size:36rpx;align-items:center;'+('height:'+navigationBarHeight+'px;line-height:'+navigationBarHeight+'px')}}"><view data-event-opts="{{[['tap',[['tuichu',['$event']]]]]}}" style="width:100rpx;text-align:center;" bindtap="__e"><image style="width:20rpx;height:34rpx;" src="/static/images/mv_tuichu.png"></image></view><view>我的推广</view><view style="width:100rpx;"></view></view></view><view style="{{('height:'+(statusBarHeight+navigationBarHeight)+'px')}}"></view><view class="list-box"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{$root.g0}}"><view class="card"><view class="flexJusp" style="align-items:center;margin-bottom:8rpx;"><view style="font-size:32rpx;font-weight:bold;color:#333333;">{{item.m0}}</view><view data-event-opts="{{[['tap',[['goOrders',['$0'],[[['list','',index]]]]]]]}}" class="order-btn" bindtap="__e"><text>查看订单</text></view></view><view style="font-size:26rpx;color:#666666;margin-bottom:16rpx;">{{item.m1}}</view><view class="flexJusp" style="align-items:center;"><view data-event-opts="{{[['tap',[['goRates',['$0'],[[['list','',index]]]]]]]}}" class="action-btn" bindtap="__e">设置价格比例</view><view data-event-opts="{{[['tap',[['confirmDelete',['$0'],[[['list','',index]]]]]]]}}" class="action-btn danger" bindtap="__e">删除</view></view></view></block><block wx:else><view class="empty">暂无下级</view></block></block></view><view data-event-opts="{{[['tap',[['openEdit']]]]}}" class="buttons" bindtap="__e">新增推广</view><block wx:if="{{showEdit}}"><view class="mask"><view class="modal"><view style="font-size:32rpx;font-weight:bold;text-align:center;">{{form.id?'编辑下级':'新增推广'}}</view><block wx:if="{{!form.id}}"><view class="promote-tabs"><view data-event-opts="{{[['tap',[['switchPromoteType',['mobile']]]]]}}" class="{{['tab-item',(promoteType==='mobile')?'active':'']}}" bindtap="__e">填写手机号</view><view data-event-opts="{{[['tap',[['switchPromoteType',['qrcode']]]]]}}" class="{{['tab-item',(promoteType==='qrcode')?'active':'']}}" bindtap="__e">展示二维码</view></view></block><view class="form"><block wx:if="{{promoteType==='mobile'||form.id}}"><view class="form-item"><view class="label">手机号</view><input type="number" placeholder="请输入手机号" data-event-opts="{{[['input',[['__set_model',['$0','mobile','$event',[]],['form']]]]]}}" value="{{form.mobile}}" bindinput="__e"/></view></block><block wx:if="{{promoteType==='qrcode'&&!form.id}}"><view class="qrcode-box"><view class="qrcode-tip">扫描下方二维码进行推广</view><block wx:if="{{qrcodeUrl}}"><view class="qrcode-image-wrapper"><image class="qrcode-image" src="{{qrcodeUrl}}" mode="aspectFit"></image></view></block><block wx:else><view class="qrcode-loading">加载中...</view></block><block wx:if="{{qrcodeUrl}}"><view data-event-opts="{{[['tap',[['downloadQrcode',['$event']]]]]}}" class="qrcode-download-btn" bindtap="__e">下载二维码</view></block></view></block></view><view class="modal-actions"><view data-event-opts="{{[['tap',[['closeEdit',['$event']]]]]}}" class="modal-btn cancel" bindtap="__e">取消</view><block wx:if="{{promoteType==='mobile'||form.id}}"><view data-event-opts="{{[['tap',[['saveSubordinate',['$event']]]]]}}" class="modal-btn confirm" bindtap="__e">保存</view></block><block wx:else><view data-event-opts="{{[['tap',[['closeEdit',['$event']]]]]}}" class="modal-btn confirm" bindtap="__e">关闭</view></block></view></view></view></block></view>