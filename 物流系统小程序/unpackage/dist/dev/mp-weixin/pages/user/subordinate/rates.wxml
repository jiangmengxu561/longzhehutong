<view class="rates"><view style="width:750rpx;height:272rpx;background:linear-gradient( 180deg, #D8EEFC 0%, #F7F8FA 100%);"></view><view style="margin-top:-272rpx;"></view><view style="{{'width:750rpx;z-index:9;position:fixed;top:0;left:0;color:#000;'+(scrollTop>0?'background:#FFF;height:'+(statusBarHeight+navigationBarHeight)+'px':'')}}"><view style="{{('height:'+statusBarHeight+'px')}}"></view><view class="flexJusp" style="{{'font-weight:bold;font-size:36rpx;align-items:center;'+('height:'+navigationBarHeight+'px;line-height:'+navigationBarHeight+'px')}}"><view data-event-opts="{{[['tap',[['tuichu',['$event']]]]]}}" style="width:100rpx;text-align:center;" bindtap="__e"><image style="width:20rpx;height:34rpx;" src="/static/images/mv_tuichu.png"></image></view><view>{{titleText}}</view><view style="width:100rpx;"></view></view></view><view style="{{('height:'+(statusBarHeight+navigationBarHeight)+'px')}}"></view><view class="list-box"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{$root.g0}}"><view class="card"><view style="font-size:30rpx;font-weight:bold;color:#333333;">{{item.m0}}</view><view style="margin:10rpx 0 6rpx;color:#666;">{{item.m1}}</view><view style="font-size:24rpx;color:#999;">正数上调，负数下调，0 表示不调整</view><view class="flexJusp" style="margin-top:18rpx;align-items:center;"><view data-event-opts="{{[['tap',[['openEdit',['$0'],[[['list','',index]]]]]]]}}" class="action-btn" bindtap="__e">编辑</view><view data-event-opts="{{[['tap',[['confirmDelete',['$0'],[[['list','',index]]]]]]]}}" class="action-btn danger" bindtap="__e">删除</view></view></view></block><block wx:else><view class="empty">暂无比例</view></block></block></view><view data-event-opts="{{[['tap',[['openEdit']]]]}}" class="buttons" bindtap="__e">新增比例</view><block wx:if="{{showEdit}}"><view class="mask"><view class="modal"><view style="font-size:32rpx;font-weight:bold;text-align:center;">{{form.id?'编辑比例':'新增比例'}}</view><view class="form"><view class="form-item"><view class="label">发货城市 *</view><input placeholder="请输入发货城市" data-event-opts="{{[['input',[['__set_model',['$0','from_province','$event',[]],['form']]]]]}}" value="{{form.from_province}}" bindinput="__e"/></view><view class="form-item"><view class="label">收货城市 *</view><input placeholder="请输入收货城市" data-event-opts="{{[['input',[['__set_model',['$0','to_province','$event',[]],['form']]]]]}}" value="{{form.to_province}}" bindinput="__e"/></view><view class="form-item"><view class="label">调整百分比 *</view><input type="number" placeholder="正数上调，负数下调，0 不调" data-event-opts="{{[['input',[['__set_model',['$0','percent','$event',[]],['form']]]]]}}" value="{{form.percent}}" bindinput="__e"/></view></view><view class="modal-actions"><view data-event-opts="{{[['tap',[['closeEdit',['$event']]]]]}}" class="modal-btn cancel" bindtap="__e">取消</view><view data-event-opts="{{[['tap',[['saveRate',['$event']]]]]}}" class="modal-btn confirm" bindtap="__e">保存</view></view></view></view></block></view>