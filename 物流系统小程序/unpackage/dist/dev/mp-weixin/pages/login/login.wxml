<view class="login"><view style="width:750rpx;height:272rpx;background:linear-gradient( 180deg, #D8EEFC 0%, #FFFFFF 100%);"></view><view style="margin-top:-272rpx;"></view><view style="{{('height:'+statusBarHeight+'px')}}"></view><view class="flexJusp" style="{{'font-weight:bold;font-size:36rpx;color:#333333;align-items:center;'+('height:'+navigationBarHeight+'px;')}}"><view data-event-opts="{{[['tap',[['fanhui',['$event']]]]]}}" style="width:100rpx;text-align:center;" bindtap="__e"><image style="width:20rpx;height:34rpx;" src="/static/images/mv_tuichu.png"></image></view><view style="width:100rpx;"></view></view><image class="logo" src="/static/logo.jpg"></image><view style="text-align:center;font-size:32rpx;color:#333;font-weight:600;">龙喆互通</view><view class="channel-wrapper"><picker mode="selector" range="{{channelList}}" range-key="name" value="{{channelIndex}}" data-event-opts="{{[['change',[['onChannelChange',['$event']]]]]}}" bindchange="__e"><view class="channel-picker-box"><view class="channel-label">推荐来源</view><view class="channel-value">{{''+(channelIndex>0?channelList[channelIndex].name:'请选择来源渠道')+''}}</view><image class="arrow" src="/static/images/icon_xiala.png"></image></view></picker></view><button class="buttons no-click-effect" type="default" open-type="getPhoneNumber" data-event-opts="{{[['getphonenumber',[['decryptPhoneNumber',['$event']]]]]}}" bindgetphonenumber="__e"><view class="flex" style="align-items:center;justify-content:center;"><view style="font-weight:bold;font-size:32rpx;color:#FFFFFF;">手机号快捷登录</view></view></button><view class="flex agreement-box"><block wx:if="{{check}}"><image style="width:28rpx;height:28rpx;" src="/static/images/icon_1xuan1.png" data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" bindtap="__e"></image></block><block wx:else><image style="width:28rpx;height:28rpx;" src="/static/images/icon_1xuan.png" data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" bindtap="__e"></image></block><view><text data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" bindtap="__e">已阅读并同意</text><text data-event-opts="{{[['tap',[['agreement',['yonghu']]]]]}}" style="color:#4878FF;" bindtap="__e">《用户协议》</text><text data-event-opts="{{[['tap',[['agreement',['yinsi']]]]]}}" style="color:#4878FF;" bindtap="__e">《隐私协议》</text><text data-event-opts="{{[['tap',[['agreement',['shiyong']]]]]}}" style="color:#4878FF;" bindtap="__e">《软件使用协议》</text></view></view></view>