',['$0'],[[['list','',index]]]]]]]}}" class="buttonx" style="margin-right:16rpx;" bindtap="__e">查看驳回原因</view></block><block wx:if="{{item.pay_status==8}}"><view data-event-opts="{{[['tap',[['xiugaiOrder',['$0'],[[['list','',index]]]]]]]}}" class="buttons" style="margin-right:16rpx;" bindtap="__e">修改订单</view></block><block wx:if="{{item.pay_status==4||item.pay_status==2||item.pay_status==3}}"><view data-event-opts="{{[['tap',[['chonglai',['$0'],[[['list','',index]]]]]]]}}" class="buttonx" bindtap="__e">再来一单</view></block><block wx:if="{{item.logistics_status==1&&item.pay_status==1}}"><view data-event-opts="{{[['tap',[['quxiao',['$0'],[[['list','',index]]]]]]]}}" class="buttonx" bindtap="__e">取消订单</view></block><block wx:if="{{item.pay_status==1}}"><view data-event-opts="{{[['tap',[['fukuan',['$0'],[[['list','',index]]]]]]]}}" class="buttons" style="margin-left:16rpx;" bindtap="__e">立即付款</view></block><block wx:if="{{item.pay_status==7}}"><view data-event-opts="{{[['tap',[['queren',['$0'],[[['list','',index]]]]]]]}}" class="buttons" style="margin-left:16rpx;" bindtap="__e">确认价格</view></block><block wx:if="{{item.pay_status==2||item.pay_status==3}}"><view data-event-opts="{{[['tap',[['details',['$0'],[[['list','',index]]]]]]]}}" class="buttonx" bindtap="__e">查看详情</view></block><block wx:if="{{membertype===4&&item.pay_status!=8}}"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({item})}}" class="{{['button-print',(isConnected)?'button-print-connected':'']}}" style="margin-left:16rpx;" catchtap="__e"><text class="print-icon">🖨️</text><text>{{isConnected?'打印':'连接'}}</text></view></block></view></view></view></block><block wx:if="{{showDeviceModal}}"><view data-event-opts="{{[['tap',[['closeDeviceModal',['$event']]]]]}}" class="device-modal" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="device-modal-content" catchtap="__e"><view class="device-modal-header"><text class="device-modal-title">选择蓝牙打印机</text><text data-event-opts="{{[['tap',[['closeDeviceModal',['$event']]]]]}}" class="device-modal-close" bindtap="__e">✕</text></view><scroll-view class="device-modal-list" scroll-y="{{true}}"><block wx:for="{{sortedDevices}}" wx:for-item="device" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectDevice',['$0'],[[['sortedDevices','',index]]]]]]]}}" class="{{['device-item',(!device.connectable)?'device-item-disabled':'']}}" bindtap="__e"><view class="device-item-info"><view class="device-item-name"><text class="{{['device-status',device.connectable?'device-status-ok':'device-status-no']}}">{{''+(device.connectable?'✓':'✗')+''}}</text><text class="device-name">{{device.name||'未知设备'}}</text></view><view class="device-item-id">{{device.deviceId}}</view><block wx:if="{{device.RSSI}}"><view class="device-item-rssi">{{"信号: "+device.RSSI+"dBm"}}</view></block></view></view></block><block wx:if="{{$root.g0===0}}"><view class="device-empty"> 正在搜索设备... </view></block></scroll-view><view class="device-modal-footer"><view data-event-opts="{{[['tap',[['closeDeviceModal',['$event']]]]]}}" class="device-modal-btn" bindtap="__e">取消</view><view data-event-opts="{{[['tap',[['searchBluetoothDevices',['$event']]]]]}}" class="device-modal-btn device-modal-btn-primary" bindtap="__e">重新搜索</view></view></view></view></block></view>