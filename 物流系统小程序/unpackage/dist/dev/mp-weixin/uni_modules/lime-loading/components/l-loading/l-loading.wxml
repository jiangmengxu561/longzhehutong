<view class="{{['l-class','l-loading','l-loading--'+type,[(vertical)?'is-vertical':'']]}}" style="{{'color:'+(inheritColor?'inherit':'')+';'}}"><block wx:if="{{type=='ball'}}"><view class="l-loading__ball" style="{{$root.s0}}"></view></block><block wx:if="{{type=='circular'}}"><view class="l-loading__circular" style="{{$root.s1}}"></view></block><block wx:if="{{type=='spinner'}}"><view class="l-loading__spinner" style="{{$root.s2}}"><block wx:for="{{12}}" wx:for-item="item" wx:for-index="__i0__" wx:key="*this"><view class="l-loading__dot" style="{{'--l-loading-dot:'+(item)+';'}}"></view></block></view></block><block wx:if="{{$slots['default']||text}}"><text class="l-loading__text" style="{{$root.s3}}">{{''+text}}<slot></slot></text></block></view>