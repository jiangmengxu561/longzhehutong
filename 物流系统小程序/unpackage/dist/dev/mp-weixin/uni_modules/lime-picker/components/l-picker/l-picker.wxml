<view class="l-picker" style="{{$root.s0}}"><block wx:if="{{cancelBtn||title||confirmBtn}}"><view class="l-picker__toolbar"><block wx:if="{{cancelBtn}}"><text data-event-opts="{{[['tap',[['onCancel',['$event']]]]]}}" class="l-picker__cancel" style="{{(cancelStyle)}}" bindtap="__e">{{cancelBtn}}</text></block><block wx:if="{{title}}"><text class="l-picker__title" style="{{(titleStyle)}}">{{title}}</text></block><block wx:if="{{confirmBtn}}"><text data-event-opts="{{[['tap',[['onConfirm',['$event']]]]]}}" class="l-picker__confirm" style="{{(confirmStyle)}}" bindtap="__e">{{confirmBtn}}</text></block></view></block><slot name="header"></slot><view class="l-picker__main" style="{{$root.s1}}"><block wx:if="{{$slots.default}}"><slot></slot></block><block wx:else><block wx:for="{{columns}}" wx:for-item="options" wx:for-index="i" wx:key="i"><l-picker-item vue-id="{{'22c69fc2-1-'+i}}" options="{{options}}" column="{{i}}" value="{{$root.g0>i?pickerValue[i]:null}}" bind:__l="__l"></l-picker-item></block></block><block wx:if="{{isEmpty}}"><view class="l-picker__empty"><slot name="empty"></slot></view></block></view><slot name="footer"></slot><block wx:if="{{loading}}"><view data-ref="loadingRef" class="l-picker__loading vue-ref" style="{{$root.s2}}"><l-loading vue-id="22c69fc2-2" size="{{loadingSize}}" color="{{loadingColor}}" bind:__l="__l"></l-loading></view></block></view>