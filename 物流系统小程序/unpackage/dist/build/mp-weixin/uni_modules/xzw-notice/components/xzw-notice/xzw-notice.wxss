.xzw_notice{font-size:26rpx;height:60rpx;display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;width:100%}.xzw_notice .notice_left{margin:0 20rpx 0 0}.xzw_notice .notice_center{flex:1;height:60rpx}.xzw_notice .notice_center .swiperIn{height:60rpx;display:flex;align-items:center}.xzw_notice .notice_center .swiperIn view{overflow:hidden;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical}.xzw_notice .notice_center2{flex:1;position:relative;display:flex;align-items:center;height:60rpx;overflow:hidden}.xzw_notice .notice_center2 view{position:absolute;white-space:nowrap;padding-left:100%}.xzw_notice .notice_center2 view.fast{-webkit-animation:notice 4s linear infinite both;animation:notice 4s linear infinite both}.xzw_notice .notice_center2 view.normal{-webkit-animation:notice 6s linear infinite both;animation:notice 6s linear infinite both}.xzw_notice .notice_center2 view.slow{-webkit-animation:notice 10s linear infinite both;animation:notice 10s linear infinite both}.xzw_notice .notice_right{margin:0 0 0 20rpx}@-webkit-keyframes notice{100%{-webkit-transform:translate3d(-100%,0,0);transform:translate3d(-100%,0,0)}}@keyframes notice{100%{-webkit-transform:translate3d(-100%,0,0);transform:translate3d(-100%,0,0)}}