<view class="address"><view style="width:750rpx;height:272rpx;background:linear-gradient( 180deg, #D8EEFC 0%, #F7F8FA 100%);"></view><view style="margin-top:-272rpx;"></view><view style="{{'width:750rpx;z-index:9;position:fixed;top:0;left:0;color:#000;'+(scrollTop>0?'background:#FFF;height:'+(statusBarHeight+navigationBarHeight)+'px':'')}}"><view style="{{('height:'+statusBarHeight+'px')}}"></view><view class="flexJusp" style="{{'font-weight:bold;font-size:36rpx;align-items:center;'+('height:'+navigationBarHeight+'px;line-height:'+navigationBarHeight+'px')}}"><view data-event-opts="{{[['tap',[['tuichu',['$event']]]]]}}" style="width:100rpx;text-align:center;" bindtap="__e"><image style="width:20rpx;height:34rpx;" src="/static/images/mv_tuichu.png"></image></view><view>地址信息</view><view style="width:100rpx;"></view></view></view><view style="{{('height:'+(statusBarHeight+navigationBarHeight)+'px')}}"></view><view class="addressBox"><view class="flexJusp" style="line-height:114rpx;border-bottom:2rpx solid #F0F0F0;padding:0 20rpx;"><view style="width:160rpx;">姓名</view><input style="margin-top:34rpx;text-align:right;font-size:28rpx;" placeholder="请输入姓名" data-event-opts="{{[['input',[['__set_model',['','user_name','$event',[]]]]]]}}" value="{{user_name}}" bindinput="__e"/></view><view class="flexJusp" style="line-height:114rpx;border-bottom:2rpx solid #F0F0F0;padding:0 20rpx;"><view style="width:160rpx;">联系电话</view><input style="margin-top:34rpx;text-align:right;font-size:28rpx;" maxlength="11" type="number" placeholder="请输入联系电话" data-event-opts="{{[['input',[['__set_model',['','mobile','$event',[]]]]]]}}" value="{{mobile}}" bindinput="__e"/></view><view class="flexJusp" style="line-height:114rpx;border-bottom:2rpx solid #F0F0F0;padding:0 20rpx;"><view style="width:160rpx;">所在地址</view><view data-event-opts="{{[['tap',[['dakai',['$event']]]]]}}" class="flex" style="align-items:center;" bindtap="__e"><view>{{address||'请选择'}}</view><image style="width:24rpx;height:24rpx;margin:0 0 0 10rpx;" src="/static/images/icon_2jt.png"></image></view></view><view style="border-bottom:2rpx solid #F0F0F0;padding:0 20rpx 36rpx;"><view style="width:160rpx;padding:36rpx 0 20rpx;">详细地址</view><textarea style="width:670rpx;height:204rpx;background:#FFF;border-radius:20rpx;font-size:28rpx;padding:20rpx;" placeholder="请输入详细地址" data-event-opts="{{[['input',[['__set_model',['','detailed_address','$event',[]]]]]]}}" value="{{detailed_address}}" bindinput="__e"></textarea></view><view class="flexJusp" style="line-height:114rpx;padding:0 24rpx;align-items:center;"><view style="width:200rpx;">设为默认地址：</view><block wx:if="{{defaults==1}}"><image style="width:32rpx;height:32rpx;" src="/static/images/icon_1xuan1.png" data-event-opts="{{[['tap',[['qiehuan',['$event']]]]]}}" bindtap="__e"></image></block><block wx:else><image style="width:32rpx;height:32rpx;" src="/static/images/icon_1xuan.png" data-event-opts="{{[['tap',[['qiehuan',['$event']]]]]}}" bindtap="__e"></image></block></view></view><view data-event-opts="{{[['tap',[['addAddress',['$event']]]]]}}" class="buttons" bindtap="__e">保存</view></view>