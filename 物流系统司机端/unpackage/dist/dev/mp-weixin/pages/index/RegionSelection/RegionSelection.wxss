.post {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 750rpx;
  background-color: #FFF;
  box-shadow: 0rpx -4rpx 12rpx 2rpx rgba(0, 0, 0, 0.08);
}
.buttonxx {
  width: 220rpx;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 2rpx solid #147CFD;
  font-size: 30rpx;
  color: #147CFD;
  line-height: 84rpx;
  text-align: center;
}
.buttonss {
  width: 460rpx;
  height: 88rpx;
  background: #147CFD;
  border-radius: 12rpx;
  border: 2rpx solid #147CFD;
  font-size: 30rpx;
  color: #FFF;
  line-height: 84rpx;
  text-align: center;
}
