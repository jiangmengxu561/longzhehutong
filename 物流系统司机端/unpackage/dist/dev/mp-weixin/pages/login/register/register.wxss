page {
  background-color: #FFFFFF;
}
.logins .buttons {
  margin: 20rpx auto 28rpx;
  width: 633rpx;
  height: 92rpx;
  background: linear-gradient(180deg, #4897FF 0%, #4878FF 100%);
  border-radius: 46rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 92rpx;
  text-align: center;
}
.logins button::after {
  border: none;
}
.logins .no-click-effect {
  margin: 20rpx 0 0;
  /* 去除点击时的背景色改变效果 */
  background-color: transparent;
  /* 去除边框的点击效果，如果有需要 */
  border: none;
  /* 去除阴影等效果，如果有需要 */
  box-shadow: none;
  /* 其他你需要覆盖的点击效果样式 */
}
