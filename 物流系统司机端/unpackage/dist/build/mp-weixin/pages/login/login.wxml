view></view><view data-event-opts="{{[['tap',[['loginx',['$event']]]]]}}" class="buttons" bindtap="__e">登录</view><view data-event-opts="{{[['tap',[['register',['$event']]]]]}}" style="text-align:center;font-size:26rpx;color:#4878FF;margin-top:24rpx;" bindtap="__e">立即注册</view></view></view>